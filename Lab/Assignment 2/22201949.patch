+uint64
+sys_settickets(void)
+{
+  int n;
+  argint(0, &n);
+  if(n <= 0)
+    return -1;
+  myproc()->tickets = n;
+  return 0;
+}
diff --git a/user/test_scheduler.c b/user/test_scheduler.c
new file mode 100644
index 0000000..33dd0f4
--- /dev/null
+++ b/user/test_scheduler.c
@@ -0,0 +1,29 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+int
+main(int argc, char *argv[])
+{
+  if(argc != 2){
+    fprintf(2, "Usage: test_scheduler <tickets>\n");
+    exit(1);
+  }
+
+  int n = atoi(argv[1]);
+  if(n <= 0){
+    fprintf(2, "test_scheduler: ticket count must be positive\n");
+    exit(1);
+  }
+
+  if(settickets(n) < 0){
+    fprintf(2, "test_scheduler: settickets failed\n");
+    exit(1);
+  }
+
+  // Spin forever so the scheduler keeps running this process
+  for(;;){
+  }
+
+  exit(0);
+}
