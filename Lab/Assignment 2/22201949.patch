+
+    // Draw winning ticket in [0, total-1]
+    int winning = rand() % total;
+
+    // Walk processes, accumulating ticket counts until we pass winning
+    int counter = 0;
+    for(p = proc; p < &proc[NPROC]; p++){
+      acquire(&p->lock);
+      if(p->state == RUNNABLE){
+        counter += p->tickets;
